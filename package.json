{
  "name": "plain-office",
  "version": "1.2.1",
  "description": "Private, open-source office suite for iPhone and Android",
  "scripts": {
    "predev": "node scripts/copy-ocr.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/copy-ocr.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "npm run build && npx cap sync",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/share": "^7.0.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.15.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
